#!/usr/bin/env bash
set -euo pipefail

OSC_CODE=5379
HAS_JQ=0
if command -v jq >/dev/null 2>&1; then
  HAS_JQ=1
fi
HAS_PYTHON3=0
if command -v python3 >/dev/null 2>&1; then
  HAS_PYTHON3=1
fi

usage() {
  cat >&2 <<'EOF'
Usage:
  helm copy [--label LABEL] <text|->
  helm link <url> [label]
  helm img <path> [--b64]
  helm widget <json|file|->
  helm task <progress|done|blocked> <id> [-m MSG]
  helm memory add <name> --desc DESC [--links a,b] [--body TEXT]
  helm hook
  helm mcp
EOF
}

die() {
  printf 'helm: %s\n' "$*" >&2
  exit 2
}

json_escape() {
  local value=${1-}
  local output=''
  local character code escaped
  local i

  for ((i = 0; i < ${#value}; i++)); do
    character=${value:i:1}
    case "$character" in
      '"') output+='\"' ;;
      '\') output+='\\' ;;
      $'\b') output+='\b' ;;
      $'\f') output+='\f' ;;
      $'\n') output+='\n' ;;
      $'\r') output+='\r' ;;
      $'\t') output+='\t' ;;
      *)
        printf -v code '%d' "'$character"
        if ((code < 32)); then
          printf -v escaped '\\u%04x' "$code"
          output+=$escaped
        else
          output+=$character
        fi
        ;;
    esac
  done

  printf '%s' "$output"
}

copy_json() {
  local text=$1
  local label_set=$2
  local label=${3-}

  if ((HAS_JQ)); then
    if ((label_set)); then
      jq -cn --arg text "$text" --arg label "$label" \
        '{v:1,t:"copy",text:$text,label:$label}'
    else
      jq -cn --arg text "$text" '{v:1,t:"copy",text:$text}'
    fi
  elif ((label_set)); then
    printf '{"v":1,"t":"copy","text":"%s","label":"%s"}' \
      "$(json_escape "$text")" "$(json_escape "$label")"
  else
    printf '{"v":1,"t":"copy","text":"%s"}' "$(json_escape "$text")"
  fi
}

link_json() {
  local url=$1
  local label_set=$2
  local label=${3-}

  if ((HAS_JQ)); then
    if ((label_set)); then
      jq -cn --arg url "$url" --arg label "$label" \
        '{v:1,t:"link",url:$url,label:$label}'
    else
      jq -cn --arg url "$url" '{v:1,t:"link",url:$url}'
    fi
  elif ((label_set)); then
    printf '{"v":1,"t":"link","url":"%s","label":"%s"}' \
      "$(json_escape "$url")" "$(json_escape "$label")"
  else
    printf '{"v":1,"t":"link","url":"%s"}' "$(json_escape "$url")"
  fi
}

img_json() {
  local field=$1
  local value=$2

  if ((HAS_JQ)); then
    jq -cn --arg field "$field" --arg value "$value" \
      '{v:1,t:"img"} + {($field):$value}'
  else
    printf '{"v":1,"t":"img","%s":"%s"}' \
      "$field" "$(json_escape "$value")"
  fi
}

widget_json() {
  local html=$1

  if ((HAS_JQ)); then
    jq -cn --arg html "$html" '{v:1,t:"widget",html:$html}'
  else
    printf '{"v":1,"t":"widget","html":"%s"}' "$(json_escape "$html")"
  fi
}

trim_spaces() {
  local value=$1
  value=${value#"${value%%[![:space:]]*}"}
  value=${value%"${value##*[![:space:]]}"}
  printf '%s' "$value"
}

# Board bridge verb — payload shape is a frontend contract: {t:"task.<verb>",id,msg?}.
task_json() {
  local verb=$1
  local id=$2
  local msg_set=$3
  local msg=${4-}

  if ((HAS_JQ)); then
    if ((msg_set)); then
      jq -cn --arg t "task.$verb" --arg id "$id" --arg msg "$msg" \
        '{t:$t,id:$id,msg:$msg}'
    else
      jq -cn --arg t "task.$verb" --arg id "$id" '{t:$t,id:$id}'
    fi
  elif ((msg_set)); then
    printf '{"t":"task.%s","id":"%s","msg":"%s"}' \
      "$verb" "$(json_escape "$id")" "$(json_escape "$msg")"
  else
    printf '{"t":"task.%s","id":"%s"}' "$verb" "$(json_escape "$id")"
  fi
}

# Memory bridge verb — payload shape is a frontend contract:
# {t:"memory.write",name,desc?,links?,body?}. Links arrive comma-separated and
# become a JSON array of trimmed non-empty strings.
memory_json() {
  local name=$1
  local desc_set=$2
  local desc=$3
  local links_set=$4
  local links_csv=$5
  local body_set=$6
  local body=$7

  if ((HAS_JQ)); then
    jq -cn \
      --arg name "$name" --arg desc "$desc" --arg links "$links_csv" --arg body "$body" \
      --argjson descSet "$desc_set" --argjson linksSet "$links_set" --argjson bodySet "$body_set" '
      {t:"memory.write",name:$name}
      + (if $descSet == 1 then {desc:$desc} else {} end)
      + (if $linksSet == 1 then
          {links:($links | split(",") | map(gsub("^\\s+|\\s+$";"")) | map(select(length > 0)))}
        else {} end)
      + (if $bodySet == 1 then {body:$body} else {} end)'
  else
    local json='{"t":"memory.write","name":"'"$(json_escape "$name")"'"'
    if ((desc_set)); then
      json+=',"desc":"'"$(json_escape "$desc")"'"'
    fi
    if ((links_set)); then
      local links_json='[' part first=1
      local -a link_parts=()
      IFS=',' read -ra link_parts <<<"$links_csv"
      for part in "${link_parts[@]}"; do
        part=$(trim_spaces "$part")
        [[ -n $part ]] || continue
        ((first)) || links_json+=','
        links_json+='"'"$(json_escape "$part")"'"'
        first=0
      done
      links_json+=']'
      json+=',"links":'"$links_json"
    fi
    if ((body_set)); then
      json+=',"body":"'"$(json_escape "$body")"'"'
    fi
    json+='}'
    printf '%s' "$json"
  fi
}

emit_osc() {
  # Write the control sequence to the CONTROLLING TERMINAL, not stdout. When an
  # agent (Claude Code / Codex) runs `helm copy` as a tool, its child stdout is a
  # captured pipe the agent swallows — the OSC would never reach helm's xterm.
  # /dev/tty is the real PTY, so the widget still lands on the Stage. Fall back to
  # stdout when there's no controlling terminal (plain pipe / CI).
  local seq
  printf -v seq '\033]%s;%s\007' "$OSC_CODE" "$1"
  { printf '%s' "$seq" >/dev/tty; } 2>/dev/null || printf '%s' "$seq"
}

emit_hook_payload() {
  local payload=$1
  local seq

  # Prefer the direct PTY path. Only fall back to terminalSequence when hooks run
  # without a controlling terminal, otherwise both paths would post the card.
  printf -v seq '\033]%s;%s\007' "$OSC_CODE" "$payload"
  if { printf '%s' "$seq" >/dev/tty; } 2>/dev/null; then
    return
  fi

  printf -v seq '\033]777;helm;%s\007' "$payload"
  if ((HAS_JQ)); then
    jq -cn --arg terminalSequence "$seq" '{terminalSequence:$terminalSequence}'
  elif ((HAS_PYTHON3)); then
    TERMINAL_SEQUENCE=$seq python3 -c '
import json
import os

print(json.dumps(
    {"terminalSequence": os.environ["TERMINAL_SEQUENCE"]},
    ensure_ascii=False,
    separators=(",", ":"),
))
'
  fi
}

encode_base64() {
  if command -v base64 >/dev/null 2>&1; then
    base64 | tr -d '\r\n'
  elif command -v openssl >/dev/null 2>&1; then
    openssl base64 -A
  else
    die 'base64 encoding requires base64 or openssl'
  fi
}

helm_active=0
if [[ ${HELM+x} == x ]]; then
  helm_active=1
fi

(($# > 0)) || {
  usage
  exit 2
}

subcommand=$1
shift

case "$subcommand" in
  copy)
    label=''
    label_set=0
    while (($# > 0)); do
      case "$1" in
        --label)
          (($# >= 2)) || die '--label requires a value'
          label=$2
          label_set=1
          shift 2
          ;;
        --label=*)
          label=${1#--label=}
          label_set=1
          shift
          ;;
        --)
          shift
          break
          ;;
        -)
          break
          ;;
        -*) die "unknown copy option: $1" ;;
        *) break ;;
      esac
    done
    (($# == 1)) || die 'copy requires exactly one text argument or -'

    if [[ $1 == '-' ]]; then
      text=''
      IFS= read -r -d '' text || true
    else
      text=$1
    fi

    if ((helm_active)); then
      emit_osc "$(copy_json "$text" "$label_set" "$label")"
    else
      printf '%s\n' "$text"
    fi
    ;;

  link)
    (($# >= 1 && $# <= 2)) || die 'link requires a URL and optional label'
    url=$1
    label=${2-}
    label_set=0
    (($# == 2)) && label_set=1

    if ((helm_active)); then
      emit_osc "$(link_json "$url" "$label_set" "$label")"
    elif ((label_set)) && [[ -n $label ]]; then
      printf '%s: %s\n' "$label" "$url"
    else
      printf '%s\n' "$url"
    fi
    ;;

  img)
    image_path=''
    use_b64=0
    while (($# > 0)); do
      case "$1" in
        --b64)
          use_b64=1
          shift
          ;;
        --)
          shift
          (($# == 1)) || die 'img requires exactly one path'
          image_path=$1
          shift
          ;;
        -*) die "unknown img option: $1" ;;
        *)
          [[ -z $image_path ]] || die 'img requires exactly one path'
          image_path=$1
          shift
          ;;
      esac
    done
    [[ -n $image_path ]] || die 'img requires a path'

    if ((!helm_active)); then
      printf '%s\n' "$image_path"
    elif ((use_b64)); then
      if [[ $image_path == '-' ]]; then
        image_b64=$(encode_base64)
      else
        [[ -f $image_path ]] || die "image file not found: $image_path"
        image_b64=$(encode_base64 <"$image_path")
      fi
      emit_osc "$(img_json b64 "$image_b64")"
    else
      emit_osc "$(img_json path "$image_path")"
    fi
    ;;

  widget)
    (($# == 1)) || die 'widget requires exactly one JSON/HTML value, file, or -'
    source=$1
    if [[ $source == '-' ]]; then
      html=''
      IFS= read -r -d '' html || true
    elif [[ -f $source ]]; then
      html=''
      IFS= read -r -d '' html <"$source" || true
    else
      html=$source
    fi

    if ((helm_active)); then
      emit_osc "$(widget_json "$html")"
    else
      printf '%s\n' "$html"
    fi
    ;;

  task)
    (($# >= 1)) || die 'task requires a verb: progress, done, or blocked'
    verb=$1
    shift
    case "$verb" in
      progress | done | blocked) ;;
      *) die "unknown task verb: $verb" ;;
    esac

    task_id=''
    task_id_set=0
    msg=''
    msg_set=0
    while (($# > 0)); do
      case "$1" in
        -m | --msg)
          (($# >= 2)) || die "$1 requires a value"
          msg=$2
          msg_set=1
          shift 2
          ;;
        --msg=*)
          msg=${1#--msg=}
          msg_set=1
          shift
          ;;
        --)
          shift
          ;;
        -*) die "unknown task option: $1" ;;
        *)
          ((!task_id_set)) || die 'task takes exactly one id'
          task_id=$1
          task_id_set=1
          shift
          ;;
      esac
    done
    ((task_id_set)) || die 'task requires an id'

    if ((helm_active)); then
      emit_osc "$(task_json "$verb" "$task_id" "$msg_set" "$msg")"
    elif ((msg_set)); then
      printf 'task %s %s: %s\n' "$verb" "$task_id" "$msg"
    else
      printf 'task %s %s\n' "$verb" "$task_id"
    fi
    ;;

  memory)
    (($# >= 1)) || die 'memory requires a verb: add'
    verb=$1
    shift
    [[ $verb == add ]] || die "unknown memory verb: $verb"

    name=''
    name_set=0
    desc=''
    desc_set=0
    links_csv=''
    links_set=0
    body=''
    body_set=0
    while (($# > 0)); do
      case "$1" in
        --desc)
          (($# >= 2)) || die '--desc requires a value'
          desc=$2
          desc_set=1
          shift 2
          ;;
        --desc=*)
          desc=${1#--desc=}
          desc_set=1
          shift
          ;;
        --links)
          (($# >= 2)) || die '--links requires a value'
          links_csv=$2
          links_set=1
          shift 2
          ;;
        --links=*)
          links_csv=${1#--links=}
          links_set=1
          shift
          ;;
        --body)
          (($# >= 2)) || die '--body requires a value'
          body=$2
          body_set=1
          shift 2
          ;;
        --body=*)
          body=${1#--body=}
          body_set=1
          shift
          ;;
        --)
          shift
          ;;
        -*) die "unknown memory option: $1" ;;
        *)
          ((!name_set)) || die 'memory add takes exactly one name'
          name=$1
          name_set=1
          shift
          ;;
      esac
    done
    ((name_set)) || die 'memory add requires a name'
    ((desc_set)) || die 'memory add requires --desc'

    if ((helm_active)); then
      emit_osc "$(memory_json "$name" "$desc_set" "$desc" "$links_set" "$links_csv" "$body_set" "$body")"
    else
      printf 'memory add %s: %s\n' "$name" "$desc"
    fi
    ;;

  mcp)
    (($# == 0)) || die 'mcp takes no arguments'
    exec node "$(dirname "$0")/helm-mcp.mjs"
    ;;

  hook)
    # Hooks must never fail a Claude turn. Outside helm, without a JSON runtime,
    # for malformed input, or for unsupported future events, stay silent.
    ((helm_active)) || exit 0
    if ((HAS_JQ)); then
      payload=$(jq -ce '
        if .hook_event_name == "PostToolUse"
          and (.tool_name == "Write" or .tool_name == "Edit")
          and ((.tool_input.file_path? | type) == "string")
        then
          .tool_input.file_path as $path
          | if ($path | test("\\.(png|jpe?g|gif|webp|svg)$"; "i"))
            then {v:1,t:"img",path:$path}
            else {v:1,t:"copy",text:$path,label:"edited"}
            end
        else empty
        end
      ' 2>/dev/null) || exit 0
    elif ((HAS_PYTHON3)); then
      payload=$(python3 -c '
import json
import re
import sys

try:
    data = json.load(sys.stdin)
    tool_input = data.get("tool_input")
    path = tool_input.get("file_path") if isinstance(tool_input, dict) else None
    if (
        data.get("hook_event_name") != "PostToolUse"
        or data.get("tool_name") not in ("Write", "Edit")
        or not isinstance(path, str)
    ):
        raise SystemExit(0)
    if re.search(r"\.(png|jpe?g|gif|webp|svg)$", path, re.IGNORECASE):
        payload = {"v": 1, "t": "img", "path": path}
    else:
        payload = {"v": 1, "t": "copy", "text": path, "label": "edited"}
    print(json.dumps(payload, ensure_ascii=False, separators=(",", ":")))
except (AttributeError, json.JSONDecodeError, TypeError):
    pass
' 2>/dev/null) || exit 0
    else
      exit 0
    fi
    [[ -n $payload ]] || exit 0
    emit_hook_payload "$payload" || true
    ;;

  -h | --help | help)
    usage
    ;;

  *)
    usage
    die "unknown subcommand: $subcommand"
    ;;
esac
