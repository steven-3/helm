{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helm",
  "version": "0.5.5",
  "identifier": "com.steve.helm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Helm",
        "width": 1440,
        "height": 900,
        "minWidth": 940,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "frame-src http://localhost:* http://127.0.0.1:*; worker-src 'self' blob:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/steven-3/helm-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1NDUxMzE5MkNCQTQ1MjEKUldRaFJib3NHUk5GZGRrK212VzB4bHh6TkpsNCtaR296THdSR1hGRWpyOTAxRTdBRTRQamxFNTUK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "A fast agent cockpit for AI-assisted development.",
    "longDescription": "Helm is a focused desktop cockpit for terminals, coding agents, files, and agent-generated UI widgets.",
    "copyright": "Copyright © 2026 Steve",
    "resources": {
      "../shim/": "shim/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
